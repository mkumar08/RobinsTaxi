{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd robins-taxi && npm install && npm run build -- --configuration production",
  "outputDirectory": "robins-taxi/dist/robins-taxi/browser",
  "installCommand": "echo 'install handled inside buildCommand'",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
